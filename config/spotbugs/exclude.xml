<!--
  SpotBugs/FindSecBugs exclusions. Intentionally empty.
  Every future entry must name the bug pattern and class, carry a comment with the justification,
  and be approved in review by a maintainer with the security role (BUILD_PLAN section 12).
  Prefer @SuppressFBWarnings(value = "...", justification = "...") at the narrowest scope instead.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
  <!--
    SERVLET_HEADER (FindSecBugs, Low) in RequestIdFilter.doFilterInternal: the client-supplied X-Request-Id is used
    only after it matches a 1-64 character [A-Za-z0-9._-] allow-list (RequestIdFilter.resolve); anything else is
    replaced by a random UUID. Covered by RequestIdFilterTest. Added in PR 12; needs security-role approval.
    An annotation is not used because spotbugs-annotations is LGPL-2.1, outside security/licenses-allowed.txt.
  -->
  <Match>
    <Class name="io.trailkeep.shared.observability.RequestIdFilter"/>
    <Method name="doFilterInternal"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
</FindBugsFilter>
